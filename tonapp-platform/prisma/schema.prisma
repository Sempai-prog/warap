// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Enums





// Models

model Seller {
  id                  String   @id @default(uuid())
  email               String   @unique
  password_hash       String  
  phone_primary       String   @unique
  first_name          String  
  last_name           String  
  avatar_url          String? 
  verification_status String @default("unverified")
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  last_login          DateTime?

  // Relations
  shop                    Shop?
  email_verification_tokens EmailVerificationToken[]
  phone_verification_otps   PhoneVerificationOtp[]

  @@map("sellers")
}

model Shop {
  id                  String   @id @default(uuid())
  seller_id           String   @unique
  shop_name           String  
  slug                String   @unique
  bio_description     String? 
  logo_url            String? 
  banner_url          String? 
  primary_color       String   @default("#00A86B")
  secondary_color     String? 
  typography_style    String   @default("inter_open_sans")
  layout_type         String   @default("bento")
  layout_bento_config String?   
  momo_number         String? 
  orange_money_number String? 
  whatsapp_number     String  
  secondary_contacts  String?   
  social_links        String?   
  accepts_cash_on_delivery Boolean @default(true)
  onboarding_completed Boolean @default(false)
  delivery_zones      String     @default("[]")
  view_count          Int      @default(0)
  total_sales         BigInt   @default(0)
  is_published        Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  // Relations
  seller     Seller     @relation(fields: [seller_id], references: [id])
  categories Category[]
  products   Product[]
  orders     Order[]

  @@map("shops")
}

model Category {
  id            String   @id @default(uuid())
  shop_id       String  
  name          String  
  slug          String  
  description   String? 
  icon_emoji    String? 
  display_order Int      @default(0)
  is_active     Boolean  @default(true)
  product_count Int      @default(0)
  created_at    DateTime @default(now())

  // Relations
  shop     Shop      @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shop_id, slug])
  @@index([shop_id, display_order])
  @@map("categories")
}

model Product {
  id                    String   @id @default(uuid())
  shop_id               String  
  category_id           String? 
  title                 String  
  description           String  
  price_xaf             BigInt
  stock_quantity        Int      @default(0)
  is_in_stock           Boolean  @default(true)
  image_primary_url     String  
  images_secondary_urls String?    @default("[]")
  magic_link_slug       String?  @unique
  keywords              String?   
  status                String @default("draft")
  ai_generated          Boolean  @default(true)
  view_count            Int      @default(0)
  conversion_count      Int      @default(0)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // Relations
  shop     Shop      @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  orders   Order[]

  @@index([shop_id, status])
  @@index([shop_id, created_at(sort: Desc)])
  // @@index([keywords], type: Gin)
  @@map("products")
}

model Order {
  id                     String   @id @default(uuid())
  shop_id                String  
  product_id             String  
  customer_name          String  
  customer_phone         String  
  delivery_address       String  
  special_instructions   String? 
  quantity               Int      @default(1)
  unit_price_xaf         BigInt
  total_amount_xaf       BigInt
  delivery_fee_xaf       BigInt   @default(0)
  payment_method         String  
  payment_status         String @default("pending")
  payment_transaction_id String? 
  fulfillment_status     String @default("new")
  seller_notes           String? 
  refund_reason          String? 
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  delivered_at           DateTime?

  // Relations
  shop     Shop    @relation(fields: [shop_id], references: [id], onDelete: Restrict)
  product  Product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  webhooks PaymentProviderWebhook[]

  @@index([shop_id, created_at(sort: Desc)])
  @@index([payment_status])
  @@index([fulfillment_status])
  @@index([shop_id, fulfillment_status])
  @@index([payment_transaction_id])
  @@index([customer_phone])
  @@map("orders")
}

model PaymentProviderWebhook {
  id                String   @id @default(uuid())
  webhook_signature String  
  payload_json      String    
  order_id          String? 
  status            String   @default("received")
  error_message     String? 
  received_at       DateTime @default(now())
  processed_at      DateTime?

  // Relations
  order Order? @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([webhook_signature])
  @@index([order_id])
  @@index([received_at(sort: Desc)])
  @@map("payment_providers_webhooks")
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  seller_id  String  
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  // Relations
  seller Seller @relation(fields: [seller_id], references: [id])

  @@map("email_verification_tokens")
}

model PhoneVerificationOtp {
  id           String   @id @default(uuid())
  seller_id    String  
  phone_number String  
  otp_code     String  
  attempts     Int      @default(0)
  expires_at   DateTime
  created_at   DateTime @default(now())

  // Relations
  seller Seller @relation(fields: [seller_id], references: [id])

  @@map("phone_verification_otps")
}
